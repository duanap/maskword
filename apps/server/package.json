{
  "name": "@maskword/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TMPDIR=/tmp tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "start": "node dist/index.js",
    "test": "vitest run --exclude tests/socket.integration.test.ts",
    "test:integration": "vitest run tests/socket.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@maskword/shared": "workspace:*",
    "fastify": "^5.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
